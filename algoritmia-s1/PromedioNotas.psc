Algoritmo sin_titulo
	Definir nota_1 Como Numero
	Definir nota_2 Como Numero
	Definir nota_3 Como Numero
	Definir nota_4 Como Numero
	Definir nota_5 Como Numero
	Definir promedio Como Numero
	Definir suma Como Numero
	
	Escribir "Ingresa las notas en orden de la nota 1 hasta la 5: "
	leer nota_1, nota_2, nota_3, nota_4, nota_5
	suma = nota_1 + nota_2 + nota_3 + nota_4 + nota_5
	
	promedio = suma / 5
	Imprimir  promedio
	
FinAlgoritmo
